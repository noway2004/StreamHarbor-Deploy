# StreamHarbor 标准四容器部署模板：PostgreSQL + Redis + Celery Worker
# 复制为 .env 后，务必替换所有 change_me 示例密码；不要把 .env 提交到 GitHub。
STREAMHARBOR_VERSION=1.0.0.9
TZ=Asia/Shanghai
PUBLIC_BASE_URL=http://你的NAS地址:8000
CONFIG_PATH=/vol1/1000/docker/streamharbor/config
LIBRARY_ROOT=/vol1/1000/影视库

POSTGRES_DB=streamharbor
POSTGRES_USER=streamharbor
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_PORT=5432

REDIS_PASSWORD=change_me_redis_password
REDIS_PORT=6379

CELERY_CONCURRENCY=2
TRANSFER_WAIT_SECONDS=25
GATEWAY_SECRET=change_me_to_a_long_random_secret_at_least_32_characters

LICENSE_SERVER_URL=https://sh.emxy.de
LICENSE_MACHINE_ID=
PROVIDER_MODE=cookie
